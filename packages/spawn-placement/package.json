{
  "name": "@agent-relay/spawn-placement",
  "version": "18.14.0",
  "description": "Pure spawn placement policy shared by Agent Relay control planes: memory assessment, ranking, alternatives and golden fixtures",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js",
      "default": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run --root ../.. packages/spawn-placement/src",
    "test:watch": "vitest --root ../.. packages/spawn-placement/src",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentWorkforce/relay.git",
    "directory": "packages/spawn-placement"
  },
  "license": "Apache-2.0"
}
