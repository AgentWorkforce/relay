{
  "rules": {
    "binaries": "off",
    "duplicates": "off",
    "exports": "off",
    "types": "off"
  },
  "workspaces": {
    "packages/cli": {
      "entry": ["src/cli/bootstrap.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"]
    },
    "packages/harness-driver": {
      "project": ["src/**/*.ts"]
    },
    "packages/harnesses": {
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "project": ["src/**/*.ts"]
    },
    "packages/utils": {
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    }
  },
  "ignore": ["**/*.test.ts", "scripts/**", "plugins/**", "tests/**", "packages/openclaw/bridge/**"],
  "ignoreDependencies": ["turbo"],
  "ignoreWorkspaces": [
    "packages/broker-darwin-arm64",
    "packages/broker-darwin-x64",
    "packages/broker-linux-arm64",
    "packages/broker-linux-x64",
    "packages/broker-win32-x64",
    "packages/cloud"
  ]
}
