{
  "rules": {
    "binaries": "off",
    "duplicates": "off",
    "exports": "off",
    "types": "off"
  },
  "workspaces": {
    "packages/cli": {
      "entry": ["src/cli/bootstrap.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/core-bridge": {
      "project": ["src/**/*.ts"]
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"]
    },
    "packages/config": {
      "project": ["src/**/*.ts"]
    },
    "packages/utils": {
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    }
  },
  "ignore": ["**/*.test.ts", "scripts/**", "plugins/**", "tests/**", "packages/openclaw/bridge/**"],
  "ignoreDependencies": ["turbo"],
  "ignoreWorkspaces": ["packages/cloud"]
}
