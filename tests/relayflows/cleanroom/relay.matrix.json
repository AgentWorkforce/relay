{
  "version": 1,
  "product": "relay",
  "repository": "AgentWorkforce/relay",
  "featureManifest": ".agentworkforce/features/manifest.yaml",
  "isolatedEnvironment": {
    "AGENT_RELAY_HOME": "relay-state",
    "AGENT_RELAY_DATA_DIR": "relay-state"
  },
  "environmentDefaults": {
    "AGENT_RELAY_TELEMETRY_DISABLED": "1"
  },
  "artifacts": {
    "cli-entrypoint": "packages/cli/dist/cli/index.js"
  },
  "recentMergeDays": 90,
  "evidencePolicy": {
    "critical": "integration",
    "hot": "integration",
    "standard": "contract"
  },
  "profiles": {
    "smoke": {
      "lanes": ["core"],
      "defaultRepeats": 1,
      "requireFreshSandbox": false
    },
    "full": {
      "lanes": [
        "core",
        "workspace-bootstrap",
        "agent-management",
        "messaging-mcp",
        "fleet-injection-attach",
        "workflow-cloud",
        "sdk-harness",
        "polyglot-plugins",
        "regression-corpus"
      ],
      "defaultRepeats": 3,
      "requireFreshSandbox": true
    },
    "soak": {
      "lanes": [
        "core",
        "workspace-bootstrap",
        "agent-management",
        "messaging-mcp",
        "fleet-injection-attach",
        "workflow-cloud",
        "sdk-harness",
        "polyglot-plugins",
        "regression-corpus"
      ],
      "defaultRepeats": 10,
      "requireFreshSandbox": true
    },
    "manual-smoke": {
      "lanes": [
        "workspace-bootstrap",
        "agent-management",
        "messaging-mcp",
        "workflow-cloud",
        "regression-corpus"
      ],
      "defaultRepeats": 1,
      "requireFreshSandbox": false
    }
  },
  "commonSetup": [
    {
      "id": "npm-clean-install",
      "command": ["npm", "ci"],
      "timeoutSeconds": 900,
      "requiredCommands": ["npm"]
    }
  ],
  "lanes": [
    {
      "id": "core",
      "title": "relay init, the core and delivery into running sessions",
      "requiredArtifacts": ["cli-entrypoint"],
      "routingPriority": 100,
      "issueNumbers": [],
      "featureCategories": ["init", "core", "core-delivery"],
      "issueMatch": [
        "relay init",
