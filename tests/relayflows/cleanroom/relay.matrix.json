          "id": "built-cli-command-discovery",
          "title": "The checkout-built CLI exposes the public command tree",
          "command": ["node", "packages/cli/dist/cli/index.js", "--help"],
          "timeoutSeconds": 60,
          "mustContain": ["Agent-to-agent messaging", "node", "workspace", "mcp"],
          "evidence": "integration",
          "coversCategories": ["setup", "node"]
