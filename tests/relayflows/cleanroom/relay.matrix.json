        "agent-relay-node",
        "injection",
        "cursor",
        "grok",
        "codex hook",
        "session inbox",
        "leader"
      ],
      "setup": [
        {
          "id": "build-cli",
          "command": ["npm", "run", "build:core"],
          "timeoutSeconds": 600
        },
        {
          "id": "build-core-from-source",
          "command": ["node", "tests/relayflows/core/prepare-core.mjs"],
          "timeoutSeconds": 540,
          "requiredCommands": ["cargo"],
          "whenChanged": ["crates/relay-node/"]
        }
      ],
      "scenarios": [
        {
          "id": "init-parity",
          "title": "relay init sets up and removes each agent tool",
          "command": ["node", "tests/relayflows/core/init-parity.mjs"],
          "timeoutSeconds": 180,
          "requiredCommands": ["node"],
          "evidence": "integration",
          "coversCategories": ["init"]
        },
        {
          "id": "cursor-delivery",
          "title": "A message reaches a running Cursor session through its hook",
          "command": ["node", "tests/relayflows/core/delivery.mjs"],
          "timeoutSeconds": 120,
          "requiredCommands": ["node"],
          "evidence": "integration",
          "coversCategories": ["core", "core-delivery"]
        },
        {
          "id": "grok-join",
