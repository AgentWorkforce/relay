{
  "name": "@agent-relay/monorepo",
  "version": "18.6.1",
  "private": true,
  "description": "Agent Relay monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run build:core-bridge && npm run build:chief-execution-bridge && npm run build:session && npm run build:config && npm run build:cloud && npm run build:utils && npm run build:sdk && npm run build:cli-surface && cd packages/cli && npx tsc --noEmit",
    "build": "npm run clean && npm run build:core",
    "build:core": "npm run build:core-bridge && npm run build:chief-execution-bridge && npm run build:session && npm run build:events-shim && npm run build:config && npm run build:cloud && npm run build:utils && npm run build:sdk && npm run build:integration-prompts && npm run build:cli-surface && npm run build:connect && npm run build:cli",
    "build:packages": "npm run build:core",
    "build:packages:watch": "echo 'Package watch build was removed with the simplified core surface. Use package-specific watch commands instead.'",
    "build:cli": "npm --prefix packages/cli run build",
    "build:cloud": "npm --prefix packages/cloud run build",
    "build:connect": "npm --prefix packages/connect run build",
    "build:core-bridge": "npm --prefix packages/core-bridge run build",
    "build:chief-execution-bridge": "npm --prefix packages/chief-execution-bridge run build",
    "build:utils": "npm --prefix packages/utils run build",
    "build:config": "npm --prefix packages/config run build",
    "build:integration-prompts": "npm --prefix packages/integration-prompts run build",
    "build:sdk": "npm --prefix packages/sdk run build",
    "build:session": "npm --prefix packages/session run build",
    "build:events-shim": "npm --prefix packages/events-shim run build",
    "dev:watch": "cd packages/cli && npx tsc -w",
    "dev:local": "npm run build && (cd packages/cli && npm link) && echo '✓ agent-relay linked globally'",
    "dev:unlink": "(cd packages/cli && npm unlink -g agent-relay) && echo '✓ agent-relay unlinked'",
    "dev:rebuild": "npm run build && echo '✓ Rebuilt (linked version updated)'",
    "start": "node packages/cli/dist/cli/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "npm --prefix packages/cli run lint",
    "knip": "knip",
    "syncpack": "syncpack lint",
    "audit:deps": "npm --prefix packages/cli run audit:deps",
    "pack:validate": "npm --prefix packages/cli run pack:validate",
    "clean": "rm -rf packages/cli/dist && find packages -maxdepth 2 -name dist -type d -exec rm -rf {} + 2>/dev/null || true",
    "hooks:install": "./scripts/hooks/install.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "todo:scan": "bash scripts/todo-scan.sh",
    "codegen:models": "node packages/utils/codegen-ts.mjs",
    "check:cli-versions": "node scripts/check-cli-versions.mjs",
    "update:cli-versions": "node scripts/check-cli-versions.mjs --update && npm run codegen:models",
    "codegen:models:ts": "node packages/utils/codegen-ts.mjs",
    "evals:compile": "node scripts/evals/compile-cases.mjs",
    "evals": "npm run evals:compile && node scripts/evals/run-relay-evals.mjs",
    "evals:list": "npm run evals:compile && node scripts/evals/run-relay-evals.mjs --list",
    "evals:offline": "npm run evals:compile && node scripts/evals/run-relay-evals.mjs --mode offline",
    "flows:spec:features": "node --experimental-strip-types flows/verify/features.spec.ts --out .workflow-artifacts/flows/relay.verify.features.json",
    "verify:features": "node --experimental-strip-types flows/verify/run-features.ts",
    "verify:features:check": "node --experimental-strip-types flows/verify/run-features.ts --check-only && flows check .workflow-artifacts/flows/relay.verify.features.json",
    "flows:spec:audit-manifest": "node --experimental-strip-types flows/audit/feature-manifest.spec.ts --out .workflow-artifacts/flows/relay.audit.feature-manifest.json",
    "audit:feature-manifest": "node --experimental-strip-types flows/audit/run-feature-manifest.mjs",
    "audit:feature-manifest:check": "npm run flows:spec:audit-manifest && flows check .workflow-artifacts/flows/relay.audit.feature-manifest.json",
    "flows:check": "tsc -p flows/tsconfig.json",
    "verify:cleanroom:validate": "node scripts/verify-features/cleanroom.mjs validate --profile full",
    "flows:spec:cleanroom": "node --experimental-strip-types flows/verify/cleanroom.spec.ts --out .workflow-artifacts/flows/relay.verify.cleanroom.json",
    "verify:cleanroom": "npm run flows:spec:cleanroom && flows run .workflow-artifacts/flows/relay.verify.cleanroom.json",
    "verify:cleanroom:check": "VERIFY_CLEANROOM_PROFILE=smoke npm run flows:spec:cleanroom && flows check .workflow-artifacts/flows/relay.verify.cleanroom.json",
    "flows:spec:diagnose": "node --experimental-strip-types flows/diagnose/orchestration.spec.ts --out .workflow-artifacts/flows/relay.diagnose.orchestration.json",
    "diagnose:orchestration": "npm run flows:spec:diagnose && flows run .workflow-artifacts/flows/relay.diagnose.orchestration.json",
    "diagnose:orchestration:check": "RELAY_CLOUD_PROVISIONING_DONE=1 npm run flows:spec:diagnose && flows check .workflow-artifacts/flows/relay.diagnose.orchestration.json",
    "build:cli-surface": "npm --prefix packages/cli-surface run build"
  },
  "author": "AgentWorkforce <hello@agentrelay.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentWorkforce/relay.git"
  },
  "bugs": {
    "url": "https://github.com/AgentWorkforce/relay/issues"
  },
  "homepage": "https://github.com/AgentWorkforce/relay#readme",
  "devDependencies": {
    "@agent-assistant/telemetry": "^0.4.35",
    "@agent-relay/harness-driver": "17.2.1",
    "@agentworkforce/runtime": "^4.1.23",
    "@eslint/js": "^10.0.1",
    "@relaycast/sdk": "^8.0.7",
    "@relayfile/adapter-github": "0.5.9",
    "@relayfile/relay-helpers": "^0.4.6",
    "@relayflows/sdk": "2.0.66",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.19.3",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "knip": "^5.84.1",
    "prettier": "^3.6.2",
    "syncpack": "^14.0.0",
    "turbo": "^2.8.10",
    "typescript": "5.9.3",
    "vitest": "^4.1.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.5.1",
  "overrides": {
    "brace-expansion": "^5.0.9",
    "cheerio": {
      "undici": "^7.29.0"
    },
    "flatted": "^3.4.2",
    "axios": "^1.18.1",
    "fast-uri": "^3.1.4",
    "form-data": "^4.0.6",
    "hono": "^4.12.32",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.23",
    "shell-quote": "^1.10.0",
    "smol-toml": "^1.7.1",
    "tar": "^7.5.22",
    "@relayflows/sdk": {
      "@agent-relay/sdk": "18.6.1",
      "@agent-relay/harness-driver": "17.2.1"
    }
  }
}
